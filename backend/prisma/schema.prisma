// Prisma Schema for Guess Investor
// Modelos migrados desde AsyncStorage del frontend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Cambiar a "postgresql" en producción
  url      = env("DATABASE_URL")
}

// ============================================================================
// PREDICTIONS - Predicciones generadas y su tracking
// ============================================================================

model Prediction {
  id                String    @id @default(uuid())
  symbol            String
  asset             String?   // Nombre del activo (ej: "Apple", "Bitcoin")
  assetType         String    // "stock" | "crypto" | "etf" | "commodity"
  timeframe         String    // "intraday" | "swing" | "longterm"
  timeframeDays     Int       @default(1) // Días hasta fecha objetivo
  predictionType    String    @default("close") // "close" (cierre del día) | "open_next_day" (apertura del día siguiente)
  
  // Predicción
  direction         String    // "up" | "down" | "neutral"
  predictedChange   Float     // % esperado
  confidence        Float     // 0-100
  currentPrice      Float
  targetPrice       Float
  predictedPriceMin Float?
  predictedPriceMax Float?
  currency          String    @default("EUR")
  
  // Fechas
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  
  // Verificación (se llena después)
  verified          Boolean   @default(false)
  verifiedAt        DateTime?
  actualPrice       Float?
  actualChange      Float?
  actualDirection   String?   // "up" | "down" | "neutral"
  directionCorrect  Boolean?
  withinRange       Boolean?  // ¿El precio cayó dentro del rango min-max?
  priceError        Float?    // Error absoluto en %
  changeAccuracy    Float?    // Qué tan cerca estuvo del cambio predicho (0-100%)
  accuracyScore     Float?    // 0-100
  quality           String?   // "excellent" | "good" | "poor" | "failed"
  
  // Bonus por alcanzar objetivo durante el período
  targetReached     Boolean?  // ¿El precio objetivo fue alcanzado en algún momento?
  targetReachedAt   DateTime? // ¿Cuándo se alcanzó el objetivo?
  periodHigh        Float?    // Máximo del período
  periodLow         Float?    // Mínimo del período
  
  // Volatilidad para ML
  volatility        Float?    // Volatilidad anualizada del activo (%)
  volatilityCategory String?  // "low" | "medium" | "high"
  
  // Análisis detallado (JSON)
  factorBreakdown   String?   // JSON con scores de cada factor
  factorWeights     String?   // JSON con pesos usados
  reasoning         String?
  
  // Meta-learning: Uncertainty (JSON)
  uncertaintyScore  Float?    // 0-100
  uncertaintyData   String?   // JSON con factores de incertidumbre
  
  // Datos de análisis (JSON)
  sentimentData     String?   // JSON con datos de sentimiento
  historicalData    String?   // JSON con datos históricos
  technicalData     String?   // JSON con análisis técnico
  newsData          String?   // JSON con noticias
  macroData         String?   // JSON con indicadores macro
  
  // Training tracking - evitar re-entrenar con mismos datos
  usedForTraining   Boolean   @default(false) // ¿Ya se usó para entrenar pesos/clasificadores?
  trainedAt         DateTime? // ¿Cuándo se usó para entrenar?
  
  // Índices para búsquedas frecuentes
  @@index([symbol])
  @@index([verified])
  @@index([createdAt])
  @@index([symbol, timeframe])
  @@index([symbol, predictionType])
  @@index([quality])
  @@index([usedForTraining])
}

// ============================================================================
// FAVORITES - Activos favoritos del usuario
// ============================================================================

model Favorite {
  id        String   @id @default(uuid())
  symbol    String   @unique
  name      String
  assetType String
  addedAt   DateTime @default(now())
  sortOrder Int      @default(0)
  
  @@index([symbol])
}

// ============================================================================
// LEARNED WEIGHTS - Pesos aprendidos por el sistema
// ============================================================================

model LearnedWeights {
  id          String   @id @default(uuid())
  
  // Pesos por factor (0-1)
  trend       Float    @default(0.091)
  technical   Float    @default(0.091)
  sentiment   Float    @default(0.091)
  news        Float    @default(0.091)
  macro       Float    @default(0.091)
  competitors Float    @default(0.091)
  forex       Float    @default(0.091)
  institutional Float  @default(0.091)
  seasonality Float    @default(0.091)
  financials  Float    @default(0.091)
  expectations Float   @default(0.091)
  
  // Metadata
  version     Int      @default(1)
  trainedAt   DateTime @default(now())
  sampleCount Int      @default(0)
  accuracy    Float?
  
  @@index([version])
}

// ============================================================================
// ASSET ADJUSTMENTS - Ajustes específicos por activo
// ============================================================================

model AssetAdjustment {
  id              String   @id @default(uuid())
  symbol          String   @unique
  
  // Ajustes
  magnitudeScale  Float    @default(1.0)  // 0.3-1.0, reduce predicciones
  directionalBias Float    @default(0.0)  // -0.05 a +0.05
  confidenceScale Float    @default(1.0)  // 0.5-1.0
  
  // Estadísticas aprendidas
  sampleCount         Int      @default(0)
  avgPredictedChange  Float    @default(0.0)
  avgActualChange     Float    @default(0.0)
  avgError            Float    @default(0.0)
  avgAbsError         Float    @default(0.0)
  hitRate             Float    @default(0.0)
  
  // Metadata
  reason          String   @default("auto_learned") // "manual" | "auto_learned" | "predefined" | "volatility_adjustment"
  updatedAt       DateTime @updatedAt
  
  @@index([symbol])
}

// ============================================================================
// ADAPTIVE WEIGHTS STATE - Estado del sistema adaptativo
// ============================================================================

model AdaptiveState {
  id                String   @id @default(uuid())
  
  // Performance window
  directionAccuracy Float?
  avgAccuracyScore  Float?
  sampleCount       Int      @default(0)
  
  // Ajustes actuales (JSON con ajustes por factor)
  currentAdjustments String? // JSON
  
  // Metadata
  lastUpdate        DateTime @default(now())
  
  @@index([lastUpdate])
}

// ============================================================================
// CONFIDENCE CALIBRATION - Calibración de confianza
// ============================================================================

model ConfidenceCalibration {
  id              String   @id @default(uuid())
  
  // Bins de calibración (JSON array)
  calibrationBins String?  // JSON: [{binStart, binEnd, actualAccuracy, count}]
  
  // Parámetros del modelo
  slope           Float    @default(1.0)
  intercept       Float    @default(0.0)
  
  // Metadata
  trainedAt       DateTime @default(now())
  sampleCount     Int      @default(0)
  
  @@index([trainedAt])
}

// ============================================================================
// MARKET DATA CACHE - Cache de datos de mercado
// ============================================================================

model MarketDataCache {
  id          String   @id @default(uuid())
  symbol      String
  dataType    String   // "quote" | "history" | "profile" | "financials"
  timeframe   String?  // para history: "1d", "5d", "1mo", etc.
  
  data        String   // JSON con los datos
  
  cachedAt    DateTime @default(now())
  expiresAt   DateTime
  
  @@unique([symbol, dataType, timeframe])
  @@index([symbol])
  @@index([expiresAt])
}

// ============================================================================
// TRAINING CACHE - Cache de predicciones para entrenamiento
// ============================================================================

model TrainingCache {
  id              String   @id @default(uuid())
  symbol          String
  timeframe       String
  
  // Datos de la predicción
  predictedChange Float
  confidence      Float
  direction       String
  currentPrice    Float
  targetPrice     Float
  currency        String?  // Moneda del activo (EUR, USD, GBP, etc.)
  
  // Análisis (JSON)
  analysisData    String?
  
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  
  @@unique([symbol, timeframe])
  @@index([symbol])
  @@index([expiresAt])
}

// ============================================================================
// ML MODEL STATE - Estado de modelos de ML
// ============================================================================

model MLModelState {
  id          String   @id @default(uuid())
  
  // Tipo de modelo (reinforcement_learning, factor_correlation, meta_learning, probabilistic_model)
  modelType   String
  version     Int      @default(1)
  
  // Estado serializado en JSON
  stateJson   String   // JSON con el estado completo del modelo
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  
  @@unique([modelType, version])
  @@index([modelType])
}

// ============================================================================
// PRICE ALERTS - Alertas de precio
// ============================================================================

model PriceAlert {
  id                    String    @id @default(uuid())
  symbol                String
  assetName             String
  
  // Condición de alerta
  targetPrice           Float     @default(0) // 0 si se usa percentChange
  percentChange         Float?    // % de cambio para disparar
  condition             String    // "above" | "below"
  currentPriceAtCreation Float    // Precio cuando se creó la alerta
  
  // Estado
  isActive              Boolean   @default(true)
  isTriggered           Boolean   @default(false)
  triggeredAt           DateTime?
  triggeredPrice        Float?
  
  // Metadata
  note                  String?
  createdAt             DateTime  @default(now())
  expiresAt             DateTime?
  
  @@index([symbol])
  @@index([isActive])
  @@index([isTriggered])
}

// ============================================================================
// INVESTMENT NOTES - Notas y apuntes de inversión
// ============================================================================

model InvestmentNote {
  id        String   @id @default(uuid())
  symbol    String   @unique
  note      String   // Nota de texto libre
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([symbol])
}
